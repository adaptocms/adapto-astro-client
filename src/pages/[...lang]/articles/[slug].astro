---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { getDefaultLanguage } from "../../../languages/utils";
import { DEFAULT_LANGUAGE } from "../../../content.config";
import type { IArticle } from "../../../schemas/articles";
import type { ILanguageLink } from "../../../schemas/languages";

export interface ArticlePath {
  params: { slug: string; lang?: string };
  props: { article: IArticle; translationLinks: ILanguageLink[] };
}

export async function getStaticPaths(): Promise<ArticlePath[]> {
  const articles = await getCollection("articles");
  const languages = await getCollection("languages");
  const defaultLang = languages.find((l) => l.data.is_default)?.data.short;

  const paths: ArticlePath[] = [];
  const groups: Record<string, IArticle[]> = {};

  articles.forEach((article) => {
    const groupId = article.data.translation_of_id ?? article.id;
    if (!groups[groupId]) groups[groupId] = [];
    groups[groupId].push(article.data);
  });

  for (const groupId in groups) {
    const groupArticles = groups[groupId];

    // Always produce a translationLinks array
    const translationLinks: ILanguageLink[] = [];
    languages.forEach((language) => {
      const lang = language.data.short;
      const sibling = groupArticles.find(
        (a) => a.language.split("-")[0] === lang
      );
      if (sibling) {
        translationLinks.push({
          lang,
          href: `/${lang}/articles/${sibling.slug}`,
        });
      }
    });

    groupArticles.forEach((article) => {
      const lang = article.language.split("-")[0];
      const isDefault = lang === defaultLang;

      // Path with language prefix
      paths.push({
        params: { slug: article.slug, lang },
        props: { article, translationLinks },
      });

      // Path without prefix for default language
      if (isDefault) {
        paths.push({
          params: { slug: article.slug, lang: undefined },
          props: { article, translationLinks },
        });
      }
    });
  }

  return paths;
}

const defaultLanguage = await getDefaultLanguage();

const { article, translationLinks } = Astro.props;
const { lang } = Astro.params;
const currentLanguage = lang || defaultLanguage?.short || DEFAULT_LANGUAGE;
---

<Layout
  pageTitle={article.title}
  links={translationLinks}
  currentLang={currentLanguage}
>
  <p>
    <strong>Author: </strong>
    {article.author}
  </p>

  <div
    style={{ fontStyle: "italic", fontSize: "0.9em" }}
    set:html={article.content}
  />
</Layout>
