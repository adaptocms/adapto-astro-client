---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { getDefaultLanguage } from "../../../languages/utils";

type IArticleParams = {
  slug: string;
  lang: string | undefined;
};

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const defaultLanguage = await getDefaultLanguage();

  return articles.flatMap((article) => {
    const shortLang = article.data.language.split("-")[0];
    const isDefault = article.data.language === defaultLanguage?.code;

    // Use translation_of_id to find siblings
    const rootId = article.data.translation_of_id || article.id;
    const siblings = articles.filter(
      (a) => a.id === rootId || a.data.translation_of_id === rootId
    );

    const translationMap: Record<string, string> = {};
    siblings.forEach((s) => {
      const sShort = s.data.language.split("-")[0];
      translationMap[sShort] = s.data.slug;
    });

    const baseParams = { slug: article.data.slug };

    // Path 1: /en/articles/slug
    const paths = [
      {
        params: { ...baseParams, lang: shortLang } as IArticleParams,
        props: { article, translationMap },
      },
    ];

    // Path 2: /articles/slug (Default Language only)
    if (isDefault) {
      paths.push({
        params: { ...baseParams, lang: undefined },
        props: { article, translationMap },
      });
    }
    return paths;
  });
}

const defaultLanguage = await getDefaultLanguage();
const { article, translationMap } = Astro.props;
const { lang } = Astro.params;
console.log("translationMap", translationMap);

const currentLanguage = lang || defaultLanguage?.short;
---

<Layout
  pageTitle={article.data.title}
  translationMap={translationMap}
  contentType="articles"
>
  <p>
    <strong>Author: </strong>
    {article.data.author}
  </p>

  <div
    style={{ fontStyle: "italic", fontSize: "0.9em" }}
    set:html={article.data.content}
  />
</Layout>
