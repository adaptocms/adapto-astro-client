---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { buildTranslationMap } from "../../../utils/translationMap";
import { hydrateMediaPlacements } from "adapto-client-sdk";
import { DEFAULT_LANGUAGE } from "../../../../settings.ts";
import type { Article } from "adapto-client-sdk";
import type { LanguageLink } from "../../../types/languages";

interface ArticlePath {
  params: { slug: string; lang?: string };
  props: {
    article: Article;
    translationLinks: LanguageLink[];
  };
}

export async function getStaticPaths(): Promise<ArticlePath[]> {
  const articles = (await getCollection("articles")).map((a) => a.data);
  const languages = (await getCollection("languages")).map((l) => l.data);
  const defaultLang = languages.find((l) => l.is_default)?.short || "en";

  const translationMap = buildTranslationMap(articles, languages);

  const paths: ArticlePath[] = [];

  for (const groupId in translationMap) {
    const group = translationMap[groupId];

    const allTranslations = [
      group.default,
      ...Object.values(group.translations),
    ];

    // Build translation links
    const translationLinks: LanguageLink[] = languages
      .map((lang) => {
        const langCode = lang.short;
        const translated = allTranslations.find(
          (a) => a.language.split("-")[0] === langCode,
        );
        if (!translated) return null;
        return {
          lang: langCode,
          href:
            langCode === defaultLang
              ? `/articles/${translated.slug}`
              : `/${langCode}/articles/${translated.slug}`,
        };
      })
      .filter(Boolean) as LanguageLink[];

    allTranslations.forEach((article) => {
      const langCode = article.language.split("-")[0];
      const isDefault = langCode === defaultLang;

      // Prefixed URL
      paths.push({
        params: { slug: article.slug, lang: langCode },
        props: { article, translationLinks },
      });

      // Unprefixed for default language
      if (isDefault) {
        paths.push({
          params: { slug: article.slug, lang: undefined },
          props: { article, translationLinks },
        });
      }
    });
  }

  return paths;
}

const { article, translationLinks } = Astro.props;
const { lang } = Astro.params;
const currentLang = lang || DEFAULT_LANGUAGE;

const renderedContent = hydrateMediaPlacements(
  article.content,
  article.media_objects_placements,
);
---

<Layout
  pageTitle={article.title}
  links={translationLinks}
  currentLang={currentLang}
>
  <p>
    <a href={lang ? `/${lang}/articles/categories` : "/articles/categories"}>
      &larr; Go back to articles
    </a>
  </p>
  <p class="muted"><strong>Author:</strong> {article.author}</p>
  <div class="prose" set:html={renderedContent} />
</Layout>
