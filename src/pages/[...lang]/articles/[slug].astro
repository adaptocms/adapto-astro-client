---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { getDefaultLanguage } from "../../../languages/utils";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const languages = await getCollection("languages");

  const defaultLanguage = await getDefaultLanguage();

  const includeLangPrefix = languages.length > 1;

  // If only one language, no need for lang prefix
  if (!includeLangPrefix) {
    const paths = articles.map((article) => ({
      params: { slug: article.data.slug },
      props: { article },
    }));
    return paths;
  }

  // Multiple languages, include lang prefix
  const paths = [];

  for (const article of articles) {
    const shortLang = article.data.language.split("-")[0];
    // Handle default language without prefix
    if (article.data.language === defaultLanguage?.code) {
      paths.push({
        params: {
          slug: article.data.slug,
          lang: undefined,
        },
        props: { article },
      });
    }
    paths.push({
      params: {
        slug: article.data.slug,
        lang: shortLang,
      },
      props: { article },
    });
  }

  return paths;
}

const { article } = Astro.props;
---

<Layout pageTitle={article.data.title}>
  <p>
    <strong>Author: </strong>
    {article.data.author}
  </p>

  <div
    style={{ fontStyle: "italic", fontSize: "0.9em" }}
    set:html={article.data.content}
  />
</Layout>
