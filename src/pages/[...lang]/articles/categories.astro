---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { DEFAULT_LANGUAGE } from "../../../../settings.ts";
import type { ICategory } from "../../../content/schemas/categories";
import type { ILanguageLink } from "../../../content/schemas/languages";

interface ICategoryPath {
  params: { lang?: string };
  props: {
    categories: ICategory[];
    translationLinks: ILanguageLink[];
  };
}

export async function getStaticPaths(): Promise<ICategoryPath[]> {
  const categories = (await getCollection("categories")).map((c) => c.data);
  const languages = (await getCollection("languages")).map((l) => l.data);

  const defaultLang =
    languages.find((l) => l.is_default)?.short || DEFAULT_LANGUAGE;

  const categoriesByLanguage: Record<string, ICategory[]> = {};
  categories.forEach((category) => {
    const langCode = category.language.split("-")[0];
    if (!categoriesByLanguage[langCode]) {
      categoriesByLanguage[langCode] = [];
    }
    categoriesByLanguage[langCode].push(category);
  });

  const translationLinks: ILanguageLink[] = Object.keys(
    categoriesByLanguage,
  ).map((langCode) => {
    return {
      lang: langCode,
      href: `/${langCode}/articles/categories`,
    };
  });

  const paths: ICategoryPath[] = [];

  Object.keys(categoriesByLanguage).forEach((langCode) => {
    const isDefault = langCode === defaultLang;
    if (isDefault) {
      // Default language path without lang param
      paths.push({
        params: { lang: undefined },
        props: {
          categories: categoriesByLanguage[langCode],
          translationLinks,
        },
      });
    }
    paths.push({
      params: { lang: langCode },
      props: {
        categories: categoriesByLanguage[langCode],
        translationLinks,
      },
    });
  });

  return paths;
}

const { categories, translationLinks } = Astro.props;
const { lang } = Astro.params;

const currentLang = lang || DEFAULT_LANGUAGE;
const pageTitle = `Categories (${currentLang.toUpperCase()})`;
---

<Layout
  pageTitle={pageTitle}
  links={translationLinks}
  currentLang={currentLang}
>
  <section class="category-list">
    {
      categories.length === 0 ? (
        <p>No categories have been defined yet. Check your CMS setup.</p>
      ) : (
        <ul>
          {categories.map((category) => {
            const langCode = category.language.split("-")[0];
            const href =
              langCode === DEFAULT_LANGUAGE
                ? `/articles/category/${category.slug}`
                : `/${langCode}/articles/category/${category.slug}`;

            return (
              <li>
                <a href={href} class="category-card">
                  {category.name}
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</Layout>
