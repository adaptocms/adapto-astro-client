---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { DEFAULT_LANGUAGE } from "../../../../settings.ts";
import type { Category } from "adapto-client-sdk";
import type { LanguageLink } from "../../../types/languages";

interface CategoryPath {
  params: { lang?: string };
  props: {
    categories: Category[];
    translationLinks: LanguageLink[];
  };
}

export async function getStaticPaths(): Promise<CategoryPath[]> {
  const categories = (await getCollection("categories")).map((c) => c.data);
  const languages = (await getCollection("languages")).map((l) => l.data);

  const defaultLang =
    languages.find((l) => l.is_default)?.short || DEFAULT_LANGUAGE;

  const categoriesByLanguage: Record<string, Category[]> = {};
  categories.forEach((category) => {
    const langCode = category.language.split("-")[0];
    if (!categoriesByLanguage[langCode]) {
      categoriesByLanguage[langCode] = [];
    }
    categoriesByLanguage[langCode].push(category);
  });

  const translationLinks: LanguageLink[] = Object.keys(
    categoriesByLanguage,
  ).map((langCode) => {
    return {
      lang: langCode,
      href: `/${langCode}/articles/categories`,
    };
  });

  const paths: CategoryPath[] = [];

  Object.keys(categoriesByLanguage).forEach((langCode) => {
    const isDefault = langCode === defaultLang;
    if (isDefault) {
      // Default language path without lang param
      paths.push({
        params: { lang: undefined },
        props: {
          categories: categoriesByLanguage[langCode],
          translationLinks,
        },
      });
    }
    paths.push({
      params: { lang: langCode },
      props: {
        categories: categoriesByLanguage[langCode],
        translationLinks,
      },
    });
  });

  return paths;
}

const { categories, translationLinks } = Astro.props;
const { lang } = Astro.params;

const currentLang = lang || DEFAULT_LANGUAGE;
const pageTitle = `Categories (${currentLang.toUpperCase()})`;
---

<Layout
  pageTitle={pageTitle}
  links={translationLinks}
  currentLang={currentLang}
>
  {
    categories.length === 0 ? (
      <p class="muted">No categories have been defined yet.</p>
    ) : (
      <ul class="card-grid">
        {categories.map((category) => {
          const langCode = category.language.split("-")[0];
          const href =
            langCode === DEFAULT_LANGUAGE
              ? `/articles/category/${category.slug}`
              : `/${langCode}/articles/category/${category.slug}`;

          return (
            <li>
              <a href={href} class="card">
                {category.name}
              </a>
            </li>
          );
        })}
      </ul>
    )
  }
</Layout>
