---
import Layout from "../../layouts/Layout.astro";
import Microcopy from "../../components/Microcopy.astro";
import {
  getDefaultLanguage,
  getPageStaticPaths,
} from "../../utils/languages.ts";
import { hydrateMediaPlacements } from "adapto-client-sdk";
import { DEFAULT_LANGUAGE } from "../../../settings.ts";
import type { LanguageLink } from "../../types/languages";
import type { Page } from "adapto-client-sdk";

const defaultLanguage = await getDefaultLanguage();

export async function getStaticPaths() {
  return await getPageStaticPaths("contact");
}

const { lang, translations } = Astro.props as {
  lang: string;
  translations: Record<string, Page>;
};

const translationLinks: LanguageLink[] = Object.keys(translations).map(
  (lang) => ({
    lang,
    href: `/${lang}/contact`,
  }),
);

const activeLangKey = lang || defaultLanguage?.short || DEFAULT_LANGUAGE;
const currentPage = translations[activeLangKey];
const pageTitle = currentPage ? currentPage.title : "Contact Us";
const content = hydrateMediaPlacements(
  currentPage ? currentPage.content : "",
  currentPage ? currentPage.media_objects_placements : [],
);
---

<Layout
  pageTitle={pageTitle}
  links={translationLinks}
  currentLang={activeLangKey}
>
  {currentPage && <div class="prose" set:html={content} />}
  <form class="narrow">
    <div class="form-field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" />
    </div>
    <div class="form-field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" />
    </div>
    <div class="form-field">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="5"></textarea>
    </div>
    <button type="submit">
      <Microcopy key="contact_btn" lang={lang} />
    </button>
  </form>
</Layout>
