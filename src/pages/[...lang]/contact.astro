---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Microcopy from "../../components/Microcopy.astro";
import {
  getDefaultLanguage,
  getLanguageStaticPaths,
  buildTranslationMap,
} from "../../languages/utils";

const defaultLanguage = await getDefaultLanguage();
const pages = await getCollection("pages");

export async function getStaticPaths() {
  return await getLanguageStaticPaths();
}

const translations = buildTranslationMap(
  "contact",
  pages,
  defaultLanguage?.code || ""
);

const { lang } = Astro.params;

const activeLangKey = lang || defaultLanguage?.short || "en";
const currentPage = translations[activeLangKey];
const pageTitle = currentPage ? currentPage.title : "Contact Us";
---

<Layout pageTitle={pageTitle}>
  {
    currentPage && (
      <main>
        <div set:html={currentPage.content} />
      </main>
    )
  }
  <main class="container mx-auto px-4 py-8">
    <p>this form is hardcoded</p>
    <form class="max-w-lg mx-auto">
      <div class="mb-4">
        <label for="name" class="block text-gray-700 font-bold mb-2">Name</label
        >
        <input
          type="text"
          id="name"
          name="name"
          class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
        />
      </div>
      <div class="mb-4">
        <label for="email" class="block text-gray-700 font-bold mb-2"
          >Email</label
        >
        <input
          type="email"
          id="email"
          name="email"
          class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
        />
      </div>
      <div class="mb-6">
        <label for="message" class="block text-gray-700 font-bold mb-2"
          >Message</label
        >
        <textarea
          id="message"
          name="message"
          rows="5"
          class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
        ></textarea>
      </div>
      <div class="flex items-center justify-center">
        <p>this button has microcopy</p>
        <button
          type="submit"
          class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"
        >
          <Microcopy key="contact_btn" lang={lang} />
        </button>
      </div>
    </form>
  </main>
</Layout>
