---
import Layout from "../../layouts/Layout.astro";
import Microcopy from "../../components/Microcopy.astro";
import {
  getDefaultLanguage,
  getPagesWithTranslations,
} from "../../languages/utils";
import type { IPage } from "../../schemas/pages";
import type {
  ILanguageLink,
  ILanguagePathParams,
} from "../../schemas/languages";
import { DEFAULT_LANGUAGE } from "../../content.config";
import { getCollection } from "astro:content";

const defaultLanguage = await getDefaultLanguage();

export async function getStaticPaths() {
  const languages = await getCollection("languages");
  const pageWithTranslations = await getPagesWithTranslations("home");
  const paths: ILanguagePathParams[] = [];

  const defaultLang = languages.find((l) => l.data.is_default)?.data.short;

  for (const lang of languages) {
    const shortLang = lang.data.short;

    // Default language → root "/"
    if (shortLang === defaultLang) {
      paths.push({
        params: { lang: undefined },
        props: {
          lang: shortLang,
          translations: pageWithTranslations,
        },
      });
    }

    // All languages → "/en", "/ro", "/es"
    paths.push({
      params: { lang: shortLang },
      props: {
        lang: shortLang,
        translations: pageWithTranslations,
      },
    });
  }

  return paths;
}

const { lang, translations } = Astro.props as {
  lang: string;
  translations: Record<string, IPage>;
};

const translationLinks: ILanguageLink[] = Object.keys(translations).map(
  (lang) => ({
    lang,
    href: `/${lang}`,
  })
);

const activeLangKey = lang || defaultLanguage?.short || DEFAULT_LANGUAGE;
const currentPage = translations[activeLangKey];
const pageTitle = currentPage ? currentPage.title : "Home Page";
---

<Layout
  pageTitle={pageTitle}
  links={translationLinks}
  currentLang={activeLangKey}
>
  {
    currentPage && (
      <main>
        <h3>
          <Microcopy key="adapto" lang={activeLangKey} />
        </h3>

        <div set:html={currentPage.content} />
      </main>
    )
  }
</Layout>
