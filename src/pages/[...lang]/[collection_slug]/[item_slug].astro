---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import DraftBadge from "../../../components/DraftBadge.astro";
import { buildTranslationMap } from "../../../utils/translationMap";
import {
  DEFAULT_LANGUAGE,
  BESPOKE_COLLECTION_SLUGS,
} from "../../../../settings.ts";
import type { LanguageLink } from "../../../types/languages";
import type {
  CustomCollection,
  CustomCollectionItem,
} from "adapto-client-sdk";

interface CollectionItemPath {
  params: {
    lang: string | undefined;
    collection_slug: string;
    item_slug: string;
  };
  props: {
    item: CustomCollectionItem;
    collection: CustomCollection;
    langCode: string | undefined;
    translationLinks: LanguageLink[];
  };
}

export async function getStaticPaths() {
  const allItems = await getCollection("customCollectionItems");
  const allCollections = await getCollection("customCollections");
  const languages = (await getCollection("languages")).map((l) => l.data);

  const defaultLang =
    languages.find((l) => l.is_default)?.short || DEFAULT_LANGUAGE;

  // Skip collections that have hand-built pages (e.g. showcase)
  const filteredCollections = allCollections.filter(
    (c) => !BESPOKE_COLLECTION_SLUGS.includes(c.data.slug),
  );

  const filteredItems = allItems.filter((item) =>
    filteredCollections.some((c) => c.data.id === item.data.collection_id),
  );

  // 1. Convert Astro entries to raw data for the utility
  const itemsData = filteredItems.map((i) => i.data);

  // 2. Build the map (this handles the translation_of_id logic)
  const translationMap = buildTranslationMap(itemsData, languages);

  const paths: CollectionItemPath[] = [];

  for (const groupId in translationMap) {
    const group = translationMap[groupId];
    const allTranslations = [
      group.default,
      ...Object.values(group.translations),
    ].filter(Boolean);

    allTranslations.forEach((item) => {
      const langCode = item.language.split("-")[0];
      const isDefault = langCode === defaultLang;

      // 3. Find the parent collection for the slug
      const parentCol = allCollections.find(
        (c) => c.data.id === item.collection_id,
      );
      if (!parentCol) return;

      // 4. Build links for THIS specific item's translations
      const translationLinks: LanguageLink[] = allTranslations.map((tr) => {
        const trLang = tr.language.split("-")[0];
        return {
          lang: trLang,
          href:
            trLang === defaultLang
              ? `/${parentCol.data.slug}/${tr.slug}`
              : `/${trLang}/${parentCol.data.slug}/${tr.slug}`,
        };
      });

      const baseParams = {
        collection_slug: parentCol.data.slug,
        item_slug: item.slug,
      };

      // 5. Push paths (Prefixed)
      paths.push({
        params: { lang: langCode, ...baseParams },
        props: { item, collection: parentCol.data, langCode, translationLinks },
      });

      // 6. Push paths (Unprefixed for default)
      if (isDefault) {
        paths.push({
          params: { lang: undefined, ...baseParams },
          props: {
            item,
            collection: parentCol.data,
            langCode: undefined,
            translationLinks,
          },
        });
      }
    });
  }

  return paths;
}

const { item, collection, langCode, translationLinks } = Astro.props;

const urlBase = langCode
  ? `/${langCode}/${collection.slug}`
  : `/${collection.slug}`;

const getFieldType = (fieldName: string) => {
  return collection.fields.find((f) => f.name === fieldName)?.type || "text";
};
---

<Layout pageTitle={item.title} links={translationLinks} currentLang={langCode}>
  <article class="stack">
    <p class="muted">Collection: {collection.name} <DraftBadge status={item.status} /></p>

    <p>
      <a href={urlBase}>&larr; Go back to {collection.name}</a>
    </p>

    <div>
      {
        Object.entries(item.data || {}).map(([key, value]) => {
          const type = getFieldType(key);

          return (
            <div class="field-group">
              <div class="field-label">{key.replace("_", " ")}</div>

              <div>
                {/* Images */}
                {type === "image" &&
                  value &&
                  (typeof value === "string" ? (
                    <img src={value} alt={key} />
                  ) : (
                    (value as any).url && <img src={(value as any).url} alt={key} />
                  ))}

                {/* Rich text / textarea */}
                {(type === "rich_text" || type === "textarea") && (
                  <div class="prose" set:html={value} />
                )}

                {/* Booleans */}
                {type === "boolean" && (
                  <span class="badge">{value ? "Yes" : "No"}</span>
                )}

                {/* Colors */}
                {type === "color" && (
                  <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div class="swatch" style={{ backgroundColor: value }} />
                    <code>{value}</code>
                  </div>
                )}

                {/* Default (text, number, email, url) */}
                {![
                  "image",
                  "rich_text",
                  "textarea",
                  "boolean",
                  "color",
                ].includes(type) && <p>{value}</p>}
              </div>
            </div>
          );
        })
      }
    </div>
  </article>
</Layout>
