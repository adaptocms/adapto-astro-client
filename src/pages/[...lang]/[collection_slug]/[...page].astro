---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "../../../layouts/Layout.astro";
import Pagination from "../../../components/Pagination.astro";
import {
  CUSTOM_COLLECTIONS,
  DEFAULT_LANGUAGE,
  ARTICLES_PER_PAGE,
} from "../../../../settings.ts";
import { buildCollectionTranslationLinksFromItems } from "../../../utils/translationLinks";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allItems = await getCollection("customCollectionItems");
  const collections = await getCollection("customCollections");

  const validCollections = collections.filter(
    (c) =>
      c.data.slug !== "articles" &&
      !CUSTOM_COLLECTIONS.some((cc) => cc.slug === c.data.slug),
  );

  const allPaths = validCollections.flatMap((collectionEntry) => {
    const collection = collectionEntry.data;

    const collectionItems = allItems.filter(
      (item) => item.data.collection_id === collection.id,
    );

    const translationLinks = collectionItems.length
      ? buildCollectionTranslationLinksFromItems(
          collectionItems,
          collection.slug,
        )
      : [{ lang: DEFAULT_LANGUAGE, url: `/${collection.slug}` }];

    return translationLinks.flatMap(({ lang }) => {
      const isDefault = lang === DEFAULT_LANGUAGE;

      const itemsForLang = collectionItems.filter(
        (item) => item.data.language.split("-")[0] === lang,
      );

      return paginate(itemsForLang, {
        pageSize: ARTICLES_PER_PAGE,
        params: { collection_slug: collection.slug },
        props: {
          collection,
          translationLinks,
        },
      }).flatMap((res) => {
        const pageParam =
          res.props.page.currentPage === 1
            ? undefined
            : String(res.props.page.currentPage);

        const paths = [];

        // /en/collection-slug
        paths.push({
          params: { lang, collection_slug: collection.slug, page: pageParam },
          props: res.props,
        });

        // Default language (no lang prefix)
        if (isDefault) {
          paths.push({
            params: {
              lang: undefined,
              collection_slug: collection.slug,
              page: pageParam,
            },
            props: res.props,
          });
        }

        return paths;
      });
    });
  });

  return allPaths;
}

const { page, collection, translationLinks } = Astro.props;
const { lang } = Astro.params;

const urlBase = lang ? `/${lang}/${collection.slug}` : `/${collection.slug}`;
---

<Layout
  pageTitle={collection.name}
  currentLang={lang || DEFAULT_LANGUAGE}
  links={translationLinks}
>
  {
    page.data.length === 0 ? (
      <div class="text-gray-500 italic">
        There are no items in this collection.
      </div>
    ) : (
      <ul class="space-y-4">
        {page.data.map((item) => (
          <li>
            <a href={`${urlBase}/${item.data.slug}`}>{item.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-12">
    <Pagination
      page={page}
      basePath={`${lang || DEFAULT_LANGUAGE}/${collection.slug}`}
    />
  </div>
</Layout>
