---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import type { CollectionEntry } from "astro:content";

type CategoryEntry = CollectionEntry<"categories">;

const categories: CategoryEntry[] = await getCollection("categories");
const pageTitle = "Categories Page";
---

<Layout pageTitle={pageTitle}>
  <section class="category-list">
    {
      categories.length === 0 ? (
        <p>No categories have been defined yet. Check your CMS setup.</p>
      ) : (
        <ul>
          {categories.map((category) => (
            <li>
              <a
                href={`/categories/${category.data.slug}`}
                class="category-card"
              >
                {category.data.name}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
