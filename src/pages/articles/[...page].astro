const { page } = Astro.props;

const pageTitle = `Articles Page ${page.currentPage}`;
---

<Layout pageTitle={pageTitle}>
  <h1>Posts from External API (SSG)</h1>

  <ul style={{ listStyle: "none", padding: 0 }}>
    {
      page.data.map((article: any) => (
        <li
          style={{
            border: "1px solid #ccc",
            padding: "15px",
            marginBottom: "10px",
            borderRadius: "5px",
          }}
        >
          <h2>{article.data.title}</h2>

          <p style={{ fontStyle: "italic", fontSize: "0.9em" }}>
            {article.data.content.substring(0, 50)}...
          </p>
          <a href={`/articles/${article.data.slug}`}>Read More</a>
        </li>
      ))
    }
  </ul>

  <Pagination page={page} />
</Layout>
