---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "../../layouts/Layout.astro";
import Pagination from "../../components/Pagination.astro";
import { DEFAULT_LANGUAGE } from "../../content.config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const articles = await getCollection("articles");

  const articlesByLanguage = articles.reduce(
    (acc, article) => {
      const lang = article.data.language;
      if (!acc[lang]) {
        acc[lang] = [];
      }
      acc[lang].push(article);
      return acc;
    },
    {} as Record<string, typeof articles>
  );

  const sortedArticles = articlesByLanguage[DEFAULT_LANGUAGE].sort((a, b) =>
    a.data.title.localeCompare(b.data.title)
  );
  const paginatedArticles = paginate(sortedArticles, { pageSize: 3 });
  console.log("Paginated articles :", paginatedArticles);
  return paginatedArticles;
}

