---
import Layout from '../layouts/Layout.astro';
---

<Layout pageTitle="500: Internal Server Error">
  <main class="container mx-auto px-4 py-8 text-center">
    <h1 class="text-6xl font-bold mb-4">500</h1>
    <p class="text-2xl mb-8">Oops! Something went wrong.</p>
    <p class="text-lg text-gray-700 mb-8">
      We're experiencing some technical difficulties. Please try again later.
    </p>
    <a href="/" class="text-lg text-blue-600 hover:underline">Go back to the homepage</a>
  </main>
</Layout>
