---
import { getCollection } from "astro:content";
import { DEFAULT_LANGUAGE } from "../content.config";
import type { IMicroCopy } from "../schemas/microCopies";

const { key } = Astro.props;
const microCopies = await getCollection("microCopies");

const microCopiesByLanguage = microCopies.reduce(
  (acc, microCopy) => {
    const lang = microCopy.data.language;
    if (!acc[lang]) {
      acc[lang] = [];
    }
    acc[lang].push(microCopy.data);
    return acc;
  },
  {} as Record<string, IMicroCopy[]>
);
const microCopy = microCopiesByLanguage[DEFAULT_LANGUAGE]?.find(
  (m) => m.key === key
);
---

{microCopy?.value || "Microcopy not found"}
