---
import { getCollection } from "astro:content";

interface Props {
  langPrefix?: string;
}

const { langPrefix } = Astro.props as Props;

const customCollections = await getCollection("customCollections");

const navItems = [
  { href: "/", label: "Home" },
  { href: "/articles", label: "Articles" },
];
customCollections.forEach((collection) => {
  navItems.push({
    href: `/${collection.data.slug}`,
    label: collection.data.name,
  });
});
---

<div class="nav-links">
  {
    navItems.map((item) => (
      <a href={langPrefix ? `/${langPrefix}${item.href}` : item.href}>
        {item.label}
      </a>
    ))
  }
</div>
