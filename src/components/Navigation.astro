---
interface IProps {
  langPrefix?: string;
}

const { langPrefix } = Astro.props as IProps;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/articles", label: "Articles" },
  { href: "/categories", label: "Categories" },
  { href: "/custom-collections", label: "Custom Collections" },
];
---

<div style="display: flex; gap: 1rem;">
  {
    navItems.map((item) => {
      return (
        <a
          href={langPrefix ? `/${langPrefix}${item.href}` : item.href}
          style="margin-right: 1.5rem;"
          class="hover:underline"
        >
          {item.label}
        </a>
      );
    })
  }
</div>
