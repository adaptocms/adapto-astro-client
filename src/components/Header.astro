---
import Navigation from "./Navigation.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import { getDefaultLanguage, hasLanguagePrefixInUrl } from "../languages/utils";

const { translationMap, contentType } = Astro.props;

const defaultLanguage = await getDefaultLanguage();
const hasLangPrefix = await hasLanguagePrefixInUrl(Astro.url.pathname);

const activeLang = hasLangPrefix
  ? Astro.url.pathname.split("/")[1]
  : defaultLanguage?.short;
---

<header>
  <nav>
    <Navigation langPrefix={hasLangPrefix ? activeLang : undefined} />
    <LanguageSwitch
      currentLanguage={activeLang}
      defaultLanguage={defaultLanguage}
      currentPath={Astro.url.pathname}
      translationMap={translationMap}
      contentType={contentType}
    />
  </nav>
</header>
