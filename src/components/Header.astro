---
import { getCollection } from "astro:content";
import Navigation from "./Navigation.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import { getDefaultLanguage } from "../languages/utils";

const { translationMap, contentType } = Astro.props;

const defaultLanguage = await getDefaultLanguage();
const currentLanguage =
  Astro.url.pathname.split("/")[1] || defaultLanguage?.short;

// Logic to check if the first segment is actually a language code
const languages = await getCollection("languages");
const hasLangPrefix = languages.some((l) => l.data.short === currentLanguage);

const activeLang = hasLangPrefix ? currentLanguage : defaultLanguage?.short;
---

<header>
  <nav
    style="display: flex; align-items: center; justify-content: space-between;"
  >
    <Navigation
      currentLanguage={currentLanguage}
      defaultLanguageShort={defaultLanguage?.short}
    />
    <LanguageSwitch
      currentLanguage={activeLang}
      defaultLanguage={defaultLanguage}
      currentPath={Astro.url.pathname}
      translationMap={translationMap}
      contentType={contentType}
    />
  </nav>
</header>
