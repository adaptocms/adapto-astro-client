---
import Navigation from "./Navigation.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import { getDefaultLanguage } from "../utils/languages.ts";
import { DEFAULT_LANGUAGE } from "../content.config";

const { currentLang, links } = Astro.props;

const defaultLanguage = await getDefaultLanguage();
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const hasLangPrefix = pathSegments.length > 0 && pathSegments[0].length === 2; // crude but works
const activeLang = hasLangPrefix
  ? pathSegments[0]
  : defaultLanguage?.short || DEFAULT_LANGUAGE;
---

<header style="width: 100%; border-bottom: 1px solid #eee;">
  <nav
    style="display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 1rem 2rem; box-sizing: border-box;"
  >
    <Navigation langPrefix={hasLangPrefix ? activeLang : undefined} />

    <LanguageSwitch currentLang={currentLang} links={links} />
  </nav>
</header>
