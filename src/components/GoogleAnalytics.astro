---
import { GA_ID } from "../../settings.ts";
---

{
  GA_ID && (
    <>
      <script
        is:inline
        src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
        async
      />
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", GA_ID);
      </script>
    </>
  )
}
