---
// Small "Draft" indicator shown next to unpublished content. Drafts are only
// fetched while running `astro dev` (see withDrafts in src/lib/adapto.ts), so
// this never renders in a production build.
interface Props {
  status?: string | null;
}
const { status } = Astro.props;
---

{
  status === "draft" && (
    <span class="draft-badge" title="Draft — visible only in local development">
      Draft
    </span>
  )
}

<style>
  .draft-badge {
    display: inline-block;
    margin-left: 0.5em;
    padding: 0.15em 0.5em;
    border-radius: 999px;
    font-size: 0.7em;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #8a5a00;
    background: #fff4d6;
    border: 1px solid #f0d38a;
    vertical-align: middle;
  }
</style>
