---
import { getCollection } from "astro:content";
import type { ILanguage } from "../schemas/languages/schema";

interface IProps {
  currentLanguage: string;
  defaultLanguage: ILanguage;
  currentPath: string;
  translationMap?: Record<string, string>;
  contentType?: string;
}

const {
  currentLanguage,
  defaultLanguage,
  currentPath,
  translationMap,
  contentType,
} = Astro.props as IProps;

const languages = await getCollection("languages");

function buildUrl(targetShort: string) {
  const isDefault = targetShort === defaultLanguage.short;

  // SCENARIO A: Entity Detail Page
  if (translationMap && contentType && translationMap[targetShort]) {
    const targetSlug = translationMap[targetShort];
    return isDefault
      ? `/${contentType}/${targetSlug}`
      : `/${targetShort}/${contentType}/${targetSlug}`;
  }

  // SCENARIO B: Static Pages / Pagination
  const segments = currentPath.split("/").filter(Boolean);
  if (languages.some((language) => language.data.short === segments[0])) {
    segments.shift();
  }
  if (segments.length && /^\d+$/.test(segments.at(-1)!)) {
    segments.pop();
  }

  if (!isDefault) segments.unshift(targetShort);
  return "/" + segments.join("/");
}
---

{
  languages.length >= 2 && (
    <select id="language-switch" class="border rounded px-2 py-1 bg-white">
      {languages.map((lang) => {
        const short = lang.data.short;
        const url = buildUrl(short);

        // LOGIC: If we are on an article detail page (contentType exists),
        // disable the option if the target language is NOT in our translation map.
        // We never disable the currently active language.
        const isUnavailable =
          contentType && translationMap && !translationMap[short];
        const isDisabled = isUnavailable && short !== currentLanguage;

        return (
          <option
            value={url}
            selected={short === currentLanguage}
            disabled={isDisabled}
          >
            {lang.data.label} {isDisabled ? "(N/A)" : ""}
          </option>
        );
      })}
    </select>
  )
}

<script>
  document
    .getElementById("language-switch")
    ?.addEventListener("change", (e) => {
      if (e.target instanceof HTMLSelectElement) {
        window.location.href = e.target.value;
      }
    });
</script>
