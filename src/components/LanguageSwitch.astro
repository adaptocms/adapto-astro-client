---
import { getCollection } from "astro:content";
import type { LanguageLink } from "../types/languages";

interface Props {
  currentLang: string;
  links: LanguageLink[];
}
const availableLanguages = await getCollection("languages");
const { currentLang, links } = Astro.props as Props;
---

{
  availableLanguages.length > 1 && (
    <div class="language-switch">
      <select id="language-switch">
        {(links || []).map((link) => (
          <option value={link.href ?? ""} selected={link.lang === currentLang}>
            {link.lang.toUpperCase()}
          </option>
        ))}
      </select>
    </div>
  )
}

<script>
  document
    .getElementById("language-switch")
    ?.addEventListener("change", (e) => {
      if (e.target instanceof HTMLSelectElement) {
        window.location.href = e.target.value;
      }
    });
</script>
