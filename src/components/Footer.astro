<footer class="footer">
  <div class="footer-content">
    <p>
      &copy; {new Date().getFullYear()}{" "}
      <a
        href="https://adaptocms.com?ref=astro-starter-footer"
        target="_blank"
        rel="noopener noreferrer">Adapto CMS</a
      >. All rights reserved.
    </p>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    border-top: 1px solid var(--border);
  }

  .footer-content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    text-align: center;
  }

  .footer-content p {
    margin: 0;
    color: var(--muted);
  }

  .footer-content a {
    color: inherit;
  }
</style>
