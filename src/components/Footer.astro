---
import { hasLanguagePrefixInUrl } from "../utils/languages.ts";

const hasLangPrefix = await hasLanguagePrefixInUrl(Astro.url.pathname);

const navItems = [
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
---

<footer class="footer">
  <div class="footer-content">
    <p>&copy; {new Date().getFullYear()} Adapto. All rights reserved.</p>

    <div class="footer-links">
      {
        navItems.map((item) => {
          return (
            <a
              href={
                hasLangPrefix
                  ? `/${Astro.url.pathname.split("/")[1]}${item.href}`
                  : item.href
              }
            >
              {item.label}
            </a>
          );
        })
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    color: black;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
    padding: 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .footer-content p,
  .footer-content a {
    margin: 0;
    text-decoration: none;
    color: inherit;
  }
</style>
