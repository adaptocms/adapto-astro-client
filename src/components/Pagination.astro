---
import type { Page } from "astro";

const { page, currentLang, basePath } = Astro.props as {
  page: Page<any>;
  currentLang: string;
  basePath: string;
};

const totalPages = page.lastPage;
const currentPage = page.currentPage;

const isFirstPage = currentPage === 1;
const isLastPage = currentPage === totalPages;

/**
 * Constructs the URL based on the language and current page.
 * Handles: /articles, /articles/2, /ro/articles, /ro/articles/2
 */
function getPageUrl(targetPage: number): string {
  // 1. Build the localized base: "" or "/ro"
  const langPart = currentLang ? `/${currentLang}` : "";

  // 2. Add the content base: "/articles"
  const fullBase = `${langPart}/${basePath}`;

  // 3. Handle Page 1 vs Other pages
  if (targetPage === 1) {
    return `${fullBase}/`;
  }

  return `${fullBase}/${targetPage}`;
}

/**
 * Determines the exact array of 1-3 page numbers to display based on the rules.
 */
function getNumberedPageLabels(
  totalPages: number,
  currentPage: number
): number[] {
  if (totalPages <= 1) return [];
  if (totalPages === 2) return [1, 2];
  if (totalPages === 3) return [1, 2, 3];

  // Rules for 4 or more pages
  if (currentPage <= 2) {
    return [1, 2, 3];
  }
  if (currentPage >= totalPages - 1) {
    return [totalPages - 2, totalPages - 1, totalPages];
  }

  // Centered
  return [currentPage - 1, currentPage, currentPage + 1];
}

const numberedLabels = getNumberedPageLabels(totalPages, currentPage);
const showJumpButtons = totalPages >= 4;

if (totalPages <= 1) {
  return null;
}
---

<nav class="pagination-nav" aria-label="Pagination Navigation">
  <div class="links">
    {/* 1. GO TO FIRST PAGE BUTTON (<<) */}
    {
      showJumpButtons && !isFirstPage ? (
        <a href={getPageUrl(1)} class="nav-jump" aria-label="First Page">
          «
        </a>
      ) : (
        <span class="disabled-link nav-jump" aria-disabled="true">
          «
        </span>
      )
    }

    {/* 2. PAGE NUMBER BUTTONS */}
    {
      numberedLabels.map((label) => {
        return label === currentPage ? (
          <span class="page-number is-current" aria-current="page">
            {label}
          </span>
        ) : (
          <a
            href={getPageUrl(label)}
            class="page-number"
            aria-label={`Go to Page ${label}`}
          >
            {label}
          </a>
        );
      })
    }

    {/* 3. GO TO LAST PAGE BUTTON (>>) */}
    {
      showJumpButtons && !isLastPage ? (
        <a
          href={getPageUrl(totalPages)}
          class="nav-jump"
          aria-label="Last Page"
        >
          »
        </a>
      ) : (
        <span class="disabled-link nav-jump" aria-disabled="true">
          »
        </span>
      )
    }
  </div>
</nav>

<style>
  .pagination-nav {
    display: flex;
    justify-content: center;
    padding: 1rem 0;
  }
  .links {
    display: flex;
    gap: 4px;
    align-items: center;
  }
  a,
  .page-number,
  .nav-jump {
    padding: 8px 12px;
    border: 1px solid #0056b3;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
    transition: background-color 0.2s;
    color: #0056b3;
    cursor: pointer;
  }
  a:hover {
    background-color: #e6f7ff;
  }

  .page-number.is-current {
    background-color: #0056b3;
    color: white;
    border-color: #0056b3;
    font-weight: bold;
    pointer-events: none;
  }

  .disabled-link {
    color: #bbb;
    border: 1px solid #eee;
    cursor: default;
    background-color: #f9f9f9;
  }
</style>
