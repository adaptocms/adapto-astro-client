---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { DEFAULT_LANGUAGE } from "../../settings.ts";
import type { LanguageLink } from "../types/languages";

type Props = {
  pageTitle: string;
  currentLang?: string;
  links?: LanguageLink[];
};

// 1. Get the current path from Astro.url
const pathname = Astro.url.pathname;

// 2. Remove the default language prefix if it exists
const segments = pathname.split("/").filter(Boolean);
const isDefaultPrefix = segments[0] === DEFAULT_LANGUAGE;

const canonicalPath = isDefaultPrefix
  ? "/" + segments.slice(1).join("/")
  : pathname;

// 3. Construct the full URL (Ensure trailing slash consistency)
const canonicalURL = new URL(canonicalPath, Astro.site);

const { pageTitle, currentLang, links } = Astro.props as Props;
---

<!doctype html>
<html lang={currentLang || DEFAULT_LANGUAGE}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL.href} />
    {
      links?.map((link) => (
        <link
          rel="alternate"
          hreflang={link.lang}
          href={new URL(link.href, Astro.site).href}
        />
      ))
    }
  </head>
  <body>
    <Header currentLang={currentLang} links={links} />
    <h1>{pageTitle}</h1>
    <slot />
    <Footer />
    <script>
      import "../scripts/menu.js";
    </script>
  </body>
</html>
